# Custom headers for Cloudflare's static assets (wrangler.jsonc):
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Everything in /assets/ has a content hash in its name (index-Cq7Jkgla.js), so a changed file
# always gets a new URL: browsers may keep these for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
